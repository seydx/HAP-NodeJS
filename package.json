{
  "name": "@homebridge/hap-nodejs",
  "type": "module",
  "version": "2.3.0",
  "description": "HAP-NodeJS is a Node.js implementation of HomeKit Accessory Server.",
  "maintainers": [
    "Andreas Bauer <mail@anderl-bauer.de>"
  ],
  "author": "Khaos Tian <khaos.tian@gmail.com> (https://tz.is/)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/homebridge/HAP-NodeJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge/HAP-NodeJS.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge/HAP-NodeJS/issues"
  },
  "keywords": [
    "hap-nodejs",
    "hap",
    "homekit",
    "homekit-accessory-protocol",
    "homekit-server",
    "homekit-protocol",
    "homekit-device",
    "homekit-accessory",
    "hap-server",
    "homekit-support",
    "siri"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": "^22.12.0 || ^24 || ^26"
  },
  "scripts": {
    "check": "npm install && npm outdated",
    "clean": "rimraf dist && rimraf coverage",
    "lint": "eslint .",
    "build": "rimraf dist && tsc",
    "generate-definitions": "tsx src/lib/definitions/generate-definitions.ts && eslint --fix src/lib/definitions src/lib/Characteristic.ts src/lib/Service.ts",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run clean",
    "test": "vitest run",
    "test-coverage": "npm run test -- --coverage",
    "docs": "typedoc",
    "lint-docs": "typedoc --emit none",
    "typecheck": "tsc -p tsconfig.spec.json",
    "pretest": "npm run typecheck",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@homebridge/ciao": "^1.4.0",
    "bonjour-hap": "^3.11.0",
    "dbus-native": "^0.16.3",
    "debug": "^4.4.3",
    "fast-srp-hap": "^2.0.4",
    "futoin-hkdf": "^1.5.3",
    "source-map-support": "^0.5.21",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/debug": "^4.1.13",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^26.6.6",
    "@types/plist": "^3.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "commander": "^15.0.0",
    "escape-html": "^1.0.3",
    "eslint-plugin-format": "^2.0.1",
    "http-parser-js": "^0.5.10",
    "rimraf": "^6.1.3",
    "semver": "^7.8.5",
    "simple-plist": "^1.4.0",
    "tsx": "^4.23.15",
    "tweetnacl": "^1.0.3",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "^0.19.1"
    },
    "oxfmt": {
      "tinypool": "^2.2.0"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
